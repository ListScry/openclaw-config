# Copy to $OPENCLAW_STATE_DIR/.env (preferred), or export in your shell.
# OpenClaw auto-loads $OPENCLAW_STATE_DIR/.env without overriding existing vars.

# Required for gateway auth mode=token
OPENCLAW_GATEWAY_TOKEN=

